# QAGarden accepts either the current Vercel KV names or the Upstash names.
# Do not commit real secret values.

# Current Vercel / Upstash integration names (recommended)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Also supported aliases
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional namespace when sharing one Redis database between apps
QAGARDEN_NAMESPACE=qagarden
